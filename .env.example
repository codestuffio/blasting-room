# Anthropic: required to run the agent
ANTHROPIC_API_KEY=

# Qloo: leave empty to run with the built-in mock (synthetic data)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Mock only: full | sparse | degraded | empty (exercises thin, failing or empty Qloo data)
QLOO_MOCK_SCENARIO=full

# Ticketmaster Discovery API consumer key, for competing shows (empty = not checked)
TICKETMASTER_API_KEY=

# Agent tuning
BR_MODEL=claude-opus-5-5
BR_EFFORT=medium
BR_MAX_TURNS=20
# Agent runs per UTC day across all visitors (0 = no cap)
BR_DAILY_RUNS=100

# Server
# Behind a Cloudflare Tunnel, set to CF-Connecting-IP so the rate limit is per visitor
BR_CLIENT_IP_HEADER=
PORT=8080
STATIC_DIR=../web/build
