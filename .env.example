# Anthropic: required to run the agent
ANTHROPIC_API_KEY=

# Qloo: leave empty to run with the built-in mock (synthetic data)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Mock only: full | sparse | degraded | empty (exercises thin, failing or empty Qloo data)
QLOO_MOCK_SCENARIO=full

# Agent tuning
BR_MODEL=claude-opus-5-5
BR_EFFORT=medium
BR_MAX_TURNS=20

# Server
PORT=8080
STATIC_DIR=../web/build
